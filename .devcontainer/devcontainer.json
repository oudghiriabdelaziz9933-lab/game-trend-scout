{
  "name": "Game Trend Scout",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env",
  "postAttachCommand": "streamlit run app.py --server.headless true",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Game Trend Scout", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
